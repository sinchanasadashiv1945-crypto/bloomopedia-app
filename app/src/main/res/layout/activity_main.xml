<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="#FFF8F8">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Floweria"
        android:textSize="40sp"
        android:textStyle="bold"
        android:textColor="#E91E63"
        android:layout_marginBottom="30dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Welcome to the World of Flowers"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#444444"
        android:gravity="center"
        android:layout_marginBottom="40dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Floweria is an educational app that helps users learn about different flowers, their names, scientific details, uses, and meanings in a simple and interactive way."
        android:textSize="16sp"
        android:textColor="#555555"
        android:gravity="center"
        android:padding="20dp"
        android:layout_marginTop="10dp"/>

    <Button
        android:id="@+id/btnStart"
        android:layout_width="250dp"
        android:layout_height="wrap_content"
        android:text="Start Exploring"
        android:textSize="18sp"
        android:textColor="#FFFFFF"
        android:backgroundTint="#E91E63"
        android:padding="14dp" />

</LinearLayout>
