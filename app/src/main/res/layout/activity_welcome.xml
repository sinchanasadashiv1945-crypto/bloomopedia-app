<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@drawable/background"
    android:padding="20dp">

    <!-- 🌸 GUIDE FLOWER -->

    <ImageView
        android:id="@+id/guideFlower"
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:src="@drawable/guideflower"
        android:contentDescription="Guide Flower"
        android:layout_marginBottom="20dp"/>

    <!-- 🌸 TITLE -->

    <TextView
        android:id="@+id/titleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Welcome to Floweria 🌸"
        android:textSize="30sp"
        android:textStyle="bold"
        android:textColor="#6A0DAD"
        android:gravity="center"/>

    <!-- 🌿 SUBTITLE -->

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Let us explore beautiful flowers together!"
        android:textSize="18sp"
        android:textColor="#4A148C"
        android:gravity="center"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="30dp"/>

    <!-- 🌺 START BUTTON -->

    <Button
        android:id="@+id/btnStart"
        android:layout_width="220dp"
        android:layout_height="55dp"
        android:text="Start Exploring 🌺"
        android:textSize="18sp"
        android:textStyle="bold"/>
</LinearLayout>